{
  "name": "draftless",
  "productName": "Draftless",
  "version": "1.0.0",
  "private": true,
  "description": "Windows 上的语音输入：按一下热键说话，整理好的文字贴进当前输入框。用你自己的 Gemini 或 OpenAI 的 key",
  "license": "MIT",
  "keywords": [
    "dictation",
    "voice-input",
    "speech-to-text",
    "windows",
    "gemini",
    "openai"
  ],
  "homepage": "https://github.com/zephyr4123/fast-speak#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zephyr4123/fast-speak.git"
  },
  "type": "module",
  "main": "main.cjs",
  "bin": {
    "draftless": "bin/draftless.mjs"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "start": "node bin/draftless.mjs",
    "postinstall": "node scripts/build/fetch-electron.mjs",
    "icons": "node scripts/build/make-icon.mjs",
    "native": "node -e \"import('./src/cli/native-helper.mjs').then(m => { m.ensureHelper('.', { onBuild: () => console.log('编译原生小帮手…') }); console.log('小帮手就绪：', m.helperBinary('.')) })\"",
    "dist": "node scripts/build/package.mjs",
    "dist:zip": "node scripts/build/make-zip.mjs",
    "install-app": "powershell -ExecutionPolicy Bypass -File scripts/build/install.ps1",
    "test": "npm run test:unit && npm run test:install",
    "test:unit": "node --test --test-timeout=5000 \"test/*.test.mjs\" \"test/!(install)/**/*.test.mjs\"",
    "test:install": "node --test --test-timeout=120000 \"test/install/**/*.test.mjs\"",
    "lint": "biome check .",
    "check": "biome check . && npm test"
  },
  "dependencies": {
    "@audio/decode-webm": "1.6.1",
    "@google/genai": "2.29.0",
    "electron": "44.7.0",
    "opencc-js": "1.4.2",
    "sherpa-onnx-node": "1.13.8",
    "transcribe-cpp": "0.4.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@audio/decode-opus": "1.3.3",
    "@biomejs/biome": "2.5.15",
    "@electron/packager": "20.3.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5"
  }
}
